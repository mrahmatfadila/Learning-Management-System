{
  "name": "content-api-server",
  "version": "1.0.0",
  "description": "Standalone External Content Provider API for LMS Curriculums",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon --watch src -e ts,js --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node prisma/seed.ts",
    "db:backup": "node scripts/backupDb.js",
    "db:restore": "node scripts/restoreDb.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "nodemon": "^3.1.0",
    "prisma": "^7.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
